# Typefully API v2 key. Create in Typefully → Settings → API.
TYPEFULLY_API_KEY=replace_me

# Optional: default social set to use when creating drafts.
# Run /project-post, let the agent call typefully_account, then copy the right ID here.
TYPEFULLY_SOCIAL_SET_ID=12345

# Optional override for tests/mocks.
TYPEFULLY_API_BASE=https://api.typefully.com
